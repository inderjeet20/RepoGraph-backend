# RepoGraph Backend Environment Configuration

# Google Gemini API Key (Required for LLM analysis & text-embedding-004)
GEMINI_API_KEY=

# Optional: Qdrant Cloud (If omitted, uses embedded local storage automatically)
QDRANT_URL=
QDRANT_API_KEY=

# Optional: GitHub Token (Increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=

# Optional: Tavily API Key (If omitted, uses completely free DuckDuckGo search)
TAVILY_API_KEY=
